# Copy to .env and fill in real values. Never commit the real .env.

# HTTP port the API listens on
SERVER_PORT=3000

# MongoDB connection string
DB_URL=mongodb://localhost:27017/integrations

# GitHub OAuth access-token exchange endpoint
GITHUB_API_URL=https://github.com/login/oauth/access_token

# Credentials from your GitHub OAuth App (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# --- Optional (defaults shown) ---

# Must exactly match the "Authorization callback URL" of the OAuth App
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback
# Where the API redirects the browser back to after the OAuth dance
FRONTEND_URL=http://localhost:4200
# Comma-separated list of origins allowed by CORS (defaults to FRONTEND_URL)
CORS_ORIGINS=http://localhost:4200
# GitHub REST API base URL (change for GitHub Enterprise)
GITHUB_API_BASE_URL=https://api.github.com
# OAuth scopes requested during the authorize step
GITHUB_SCOPES=repo,user
# Timeout applied to every outbound GitHub HTTP call, in milliseconds
GITHUB_REQUEST_TIMEOUT_MS=10000

# --- Sync pipeline (defaults shown) ---

# Items requested per upstream page; GitHub caps this at 100
SYNC_PAGE_SIZE=100
# Hard stop on pages walked per resource, per run
SYNC_MAX_PAGES=20
# Repositories whose children are synced in parallel
SYNC_CONCURRENCY=4
# Attempts, including the first, for a retryable upstream failure
SYNC_MAX_RETRIES=4
# Base delay for the exponential backoff between retries, in milliseconds
SYNC_RETRY_BASE_MS=500
# Stop paginating once the remaining hourly quota falls to this, leaving
# headroom for interactive traffic such as OAuth callbacks
SYNC_RATE_LIMIT_FLOOR=50

# --- Read API (defaults shown) ---

API_DEFAULT_PAGE_SIZE=25
# Server-side cap on ?limit= so no client can request an unbounded page
API_MAX_PAGE_SIZE=100

# --- Insights (all optional) ---

# Days of inactivity before an open pull request is reported as stale
STALE_PR_DAYS=14
# Leave empty to run without AI: summaries are then computed locally from the
# same facts and the response says so. No key is ever required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_MS=20000

# --- Demo only ---

# When true, GET /api/demo/session hands out the seeded demo account's token.
# This is an authentication bypass. Never enable it on a real deployment.
DEMO_MODE=false

# --- Misc ---

# error | warn | info | debug
LOG_LEVEL=info
