{
  "name": "github-integration",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:dist": "node dist/scripts/seed.js",
    "mock-github": "ts-node src/dev/mockGithubServer.ts",
    "mock-github:dist": "node dist/dev/mockGithubServer.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "github",
    "oauth",
    "sync",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "description": "GitHub integration service: OAuth connect, incremental sync pipeline, and a paginated read API.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "axios": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "mongoose": "^8.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.4",
    "prettier": "^3.9.8",
    "supertest": "^7.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.9"
  }
}
