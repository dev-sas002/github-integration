{
  "name": "github-integration",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/index.ts\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:dist": "node dist/scripts/seed.js",
    "mock-github": "ts-node src/dev/mockGithubServer.ts",
    "mock-github:dist": "node dist/dev/mockGithubServer.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "keywords": [
    "github",
    "oauth",
    "sync",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "description": "GitHub integration service: OAuth connect, incremental sync pipeline, and a paginated read API.",
  "engines": {
    "node": "^22.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "mongoose": "^8.24.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
